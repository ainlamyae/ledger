#!/bin/sh
# Last check before anything leaves this machine: refuses the push if any
# commit in it names Claude or Anthropic in its message, author or committer —
# which catches a commit made with --no-verify, past commit-msg and pre-commit.
# Already-pushed commits aren't re-checked, only the ones this push adds.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch delete
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  bad=$(git log --format='%h %an <%ae> %cn <%ce>%n%B' $range | grep -i -E 'claude|anthropic')
  if [ -n "$bad" ]; then
    echo "pre-push: $local_ref has commits naming Claude or Anthropic:" >&2
    git log --format='%h %s' $range | sed 's/^/  /' >&2
    echo "Reword them (git rebase -i / git commit --amend) and push again." >&2
    status=1
  fi
done
exit $status
