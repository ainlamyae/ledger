#!/bin/sh
# Refuses a commit whose author or committer is Claude or Anthropic. (The
# version is stamped after the commit now: post-commit, scripts/version.cjs.)
idents="$(git var GIT_AUTHOR_IDENT) $(git var GIT_COMMITTER_IDENT)"
if printf '%s' "$idents" | grep -qi 'claude\|anthropic'; then
  echo "pre-commit: author/committer must not be Claude or Anthropic:" >&2
  echo "  $idents" >&2
  exit 1
fi
